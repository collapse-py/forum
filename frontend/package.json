{
  "name": "FORUM-forum",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.sw.json",
    "build": "npm run typecheck && vite build",
    "build:android": "npm run build && node -e \"const fs=require('fs');fs.copyFileSync('dist/forum.html','dist/index.html')\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/push-notifications": "^8.1.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-javascript-obfuscator": "^3.1.0"
  }
}
