# ============================================================
#  檔案媒體服務設定範本（TOML）
# ============================================================
#
#  用法：複製成 config.conf 後再修改。
#
#    Linux / macOS：cp config.conf.example config.conf
#    Windows：       Copy-Item config.conf.example config.conf
#    或直接執行 .\start.ps1（會先 go build 再啟動）
#
#  兩件事要注意：
#
#  1. config.conf 在 .gitignore 裡，**不要**把填了真實 token／密碼的版本
#     提交上去。本檔只提供結構與註解，不含任何真實憑證。
#  2. 設定路徑是相對於「工作目錄」的 config.conf，所以必須在 files_server/
#     目錄下啟動。
#
#  這是獨立的 Go 模組，與 backend/ 的設定檔格式不同（TOML vs key=value）。
# ============================================================


# ------------------------------------------------------------
#  監聽位址
# ------------------------------------------------------------
[server]
# 0.0.0.0 代表綁定所有介面（容器／區網內其他機器需要）。
# 只給本機用可改成 127.0.0.1。
host = "0.0.0.0"
port = 7070
# 收到 SIGTERM（docker stop、systemd restart）後，等在途請求完成的秒數。
# 超過就強制中斷 —— 症狀是「貼文存得下但圖片上傳失敗」，因為那時後端已經
# 寫完 MySQL 而檔案還沒落地。
#
# 必須**大於**部署端等待行程結束的上限（docker compose 的 stop_grace_period、
# systemd 的 TimeoutStopSec）。設得比它長不會讓請求有更多時間完成，只會讓
# 部署看起來卡住，然後被部署端先殺掉 —— 那與直接砍掉請求沒有差別。
# 0 或負值不採用，一律沿用預設值 15（與後端的 SHUTDOWN_TIMEOUT_SECONDS 相同）。
shutdown_timeout_seconds = 15

# ------------------------------------------------------------
#  存儲後端
# ------------------------------------------------------------
[storage]
# "local"（本機磁碟）或 "s3"（S3 相容，例如 MinIO）
type = "local"

# ------------------------------------------------------------
#  本機存儲（type = "local"）
# ------------------------------------------------------------
[storage.local]
# 根目錄，執行時會自動建立。這個目錄在 .gitignore 裡，放的是使用者
# 上傳的檔案 —— 絕對不能進版控。
base_dir = "./storage"
# 實際存檔案的子目錄。檔案 URL 就是 /files/<uuid>.<ext>。
files_dir = "files"
# 建立目錄／檔案的權限（八進位）。
# 0755 / 0644。跑在非 root 帳號下時請配合實際使用者調整。
dir_perm = 493
file_perm = 420

# ------------------------------------------------------------
#  S3 相容存儲（type = "s3"）
# ------------------------------------------------------------
# 改成 "s3" 時才會生效。MinIO 請把 force_path_style 設為 true。
[storage.s3]
# 例如 MinIO：http://localhost:9000
endpoint = ""
access_key = ""
secret_key = ""
region = "us-east-1"
bucket = "media"
# MinIO 需要 true（強制 path-style 網址），AWS S3 則為 false。
force_path_style = false
files_prefix = "files/"
# 預先簽名 URL 過期時間（秒）。
presign_expire_seconds = 3600

# ------------------------------------------------------------
#  上傳／刪除驗證
# ------------------------------------------------------------
[upload]
# 上傳與刪除都帶這個 token。
# **必須與 backend/config/config.conf 的 FILES_SERVER_TOKEN 完全相同。**
# 留空則**完全跳過驗證** —— 任何人都能寫入或刪除檔案，只適合本機測試。
token = "change_me"

# 單次上傳大小上限（bytes）。52428800 = 50 MB。
max_size = 52428800

# 副檔名白名單。檔案落地時一律使用 **UUID v4 + 副檔名**，而那個副檔名是由
# **檔案的位元組**決定的（不是使用者給的檔名）：一份叫 a.png 的 JPEG 會存成
# `<uuid>.jpg`，而一份叫 a.jpg 的 HTML 會被 400 拒掉。
# 程式碼的預設值就是這五種，且與後端的 validForumImageFileName 相同 —— 後端
# 不認得的副檔名（音訊）在預設值裡不存在，因為那是一個「存得下、掛不上、也
# 刪不掉」的檔案。真的需要音訊時自行加回（見 docs/KNOWN_ISSUES.md）。
allowed_files = [".jpg", ".jpeg", ".png", ".gif", ".webp"]

# 圖片正規化：重新編碼 JPEG／PNG（移除 EXIF，含 GPS、相機型號、拍攝時間、軟體名稱），
# GIF 剝掉 Comment 與非 NETSCAPE 的 Application 區塊（動畫保留），WebP 剝掉 EXIF 與
# 任何不認識的 RIFF 區塊（色彩描述 ICCP 與動畫保留）。
#
# true（預設，也是這個站该有的值）：中繼資料不會進儲存。
# false：**原樣存檔**，EXIF 含 GPS 會留在一個公開的圖片網址上。這個站的立論是
#   「匿名性由構造保證」（README），因此 false 是一次需要被看見的決定 —— 行程
#   啟動時會印一行 WARNING 說這件事（見 files_server/main.go 的 imagePolicyWarning）。
reencode = true

# 輸出的尺寸上限（像素）。JPEG／PNG 超過時被**等比縮小**（不放大）；
# GIF／WebP 超過時被**拒**（400）—— 那兩種格式不被縮小，理由見 docs/CONFIGURATION.md。
max_width = 2048
max_height = 2048

# 來源解析度上限（寬×高）。超過一律拒收，不縮小 —— 那是一道「解壓炸彈」防護：
# 一個幾 KB 的 PNG 可以宣告 20000×20000 的畫布，解開是 1.6 GB 的記憶體，而
# max_size 管不到它（這個尺寸只在標頭裡，不需要解碼就能讀）。
max_source_pixels = 24000000

# JPEG 重新編碼的品質（1–100）。超出範圍會被夾：寫 500 實際用 100，寫 0 或負值
# 沿用預設 85（0 在編碼器上是最差的那一個，不是「用預設」）。PNG 沒有這個鍵：
# PNG 一律無損，那個鍵只有一個能用的值，存在比不存在更糟。
jpeg_quality = 85

# ------------------------------------------------------------
#  限流（每 IP 的 token bucket）
# ------------------------------------------------------------
# 這個服務在很長一段時間裡完全沒有限流，而它有三類成本差異極大的端點：
# 一次 50 MiB 的 multipart 解析、一次檔案系統移除、以及每個靜態檔案請求一次的
# Redis EXISTS。後端的限流器保護不到這個程序。
#
# 兩個獨立的限制（媒體 vs 寫入）而不是一個：成本差了一個數量級，共用一個上限
# 的結果是要嘛保護不到寫入、要嘛把正常載入圖片的頁面一起擋掉。
#
# 記憶體實作、不做跨實例共享，因此放到 N 個實例後面時總上限是 N 倍 ——
# 它仍然是一個上限，而那正是這段設定的目的。要關掉請把 enabled 明確寫 false
# （例如前面已經有一個有限流的反向代理），但那一是一次需要被看見的決定。
[ratelimit]
enabled = true
media_requests_per_sec = 50
media_burst = 200
write_requests_per_sec = 2
write_burst = 20

# ------------------------------------------------------------
#  日誌
# ------------------------------------------------------------
[logger]
# trace / debug / info / warn / error
level = "info"
enable_colors = true

# ------------------------------------------------------------
#  CORS
# ------------------------------------------------------------
# 貼文附圖是直接由瀏覽器向本服務 GET 的（<img> 不受同源限制），
# 所以 allowed_origins 才需要 "*"。若把圖片改由後端代理送出，
# 就可以收緊成具體來源。
[cors]
allowed_origins = ["*"]
# 留空 = 使用程式內建預設（GET/HEAD/OPTIONS/PUT/POST/DELETE +
# Origin/Range/Accept/Accept-Language/Content-Type/X-Upload-Token/Authorization）。
# 預設值刻意涵蓋寫入方法與上傳標頭：少了它們，瀏覽器的預檢會回 204 而真正的
# 請求失敗 —— 那正是最難診斷的形狀。X-File-Token 是本服務**不讀取**的標頭，
# 曾經出現在範本裡，只會讓人誤以為它是驗證通道（真正的通道是 upload.token）。
allowed_methods = []
allowed_headers = []

# ------------------------------------------------------------
#  Redis（靜態檔案存取權杖驗證）
# ------------------------------------------------------------
# 與後端**共用同一個 Redis**：後端上傳圖片時在這裡寫入一把短 TTL 的
# 權杖並把 ?token= 附在圖片網址上，本服務據此授權該次讀取。
#
# ⚠️ token_key_prefix **必須**與後端的 MEDIA_TOKEN_KEY_PREFIX 相同。
#    不一致的症狀很明確：上傳成功，但圖片一律 403/401。
# ⚠️ token_ttl_sec 也應與後端的 MEDIA_TOKEN_TTL_SECONDS 一致；
#    後端寫入的存活時間比這裡短時，權杖會在到期前就被拒。
# ⚠️ 兩者都不能與 session 的 forum:session: 前綴相同，否則
#    session id 會被當成合法的媒體權杖。
[redis]
addr = "127.0.0.1:6379"
password = ""
db = 0
token_key_prefix = "forum:token:"
token_ttl_sec = 60

# false＝/files/* 的 GET 與 HEAD 必須帶 ?token=，且該 token 必須存在於
#        Redis；後端釋放權杖後，該網址立即失效。
# true （＝公開讀取）＝完全跳過權杖檢查，任何人拿到網址就能長期存取。
#        選 true 等於放棄媒體權杖機制，請確認這是你想要的。
public_files = false
